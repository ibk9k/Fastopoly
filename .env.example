# Liveblocks API Keys (for real-time synchronization)
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=your_liveblocks_public_key
LIVEBLOCKS_SECRET_KEY=your_liveblocks_secret_key

# Supabase Configurations (auth, room directory, leaderboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Secret used to sign HMAC seat tokens. REQUIRED in production — the app refuses
# to issue tokens without it. Generate one with: openssl rand -hex 32
# In development it falls back to LIVEBLOCKS_SECRET_KEY.
GAME_TOKEN_SECRET=

# Shared secret for the scheduled room-cleanup job (/api/cron/cleanup).
# On Vercel, set this and the platform sends it as `Authorization: Bearer <secret>`.
CRON_SECRET=
